filters:
  and:
    - file.inFolder("11-任务")
    - note["类型"] == "任务"
    - formula.归属当前项目 == true
formulas:
  deadline: if(!(note["状态"] != "已完成" && note["状态"] != "已取消"), "已结束", if(note["截止日期"].isEmpty(), "未设置", if(date(note["截止日期"]) < today(), "逾期 " + ((number(today()) - number(date(note["截止日期"]))) / 86400000).floor() + " 天", if(date(note["截止日期"]) == today(), "今天", "剩余 " + ((number(date(note["截止日期"])) - number(today())) / 86400000).ceil() + " 天"))))
  priority_rank: if(note["优先级"] == "P0", 0, if(note["优先级"] == "P1", 1, if(note["优先级"] == "P2", 2, if(note["优先级"] == "P3", 3, 9))))
  due_rank: if(note["截止日期"].isEmpty(), 999999, (number(date(note["截止日期"])) - number(today())) / 86400000)
  归属当前项目: '!note["项目"].isEmpty() && note["项目"] == this.file.asLink()'
properties:
  note.领域:
    displayName: 分类
  file.name:
    displayName: 名称
  formula.deadline:
    displayName: 期限
  formula.due_rank:
    displayName: 截止顺序（日期由近到远）
  formula.priority_rank:
    displayName: 优先顺序（紧急在前）
  formula.归属当前项目:
    displayName: 属于当前项目
  note.进度:
    displayName: 进度（0–100）
views:
  - type: project-task-table
    name: 本项目任务
    order:
      - file.name
      - 项目
      - 领域
      - 状态
      - 优先级
      - 截止日期
      - formula.deadline
    sort:
      - property: formula.due_rank
        direction: ASC
      - property: formula.priority_rank
        direction: ASC
    recordType: 任务
    projectContext: this.file.asLink()
    layout: list
