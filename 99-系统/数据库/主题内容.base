filters:
  and:
    - file.inFolder("20-知识")
    - formula.属于当前主题 == true
formulas:
  属于当前主题: list(note["主题"]).contains(this.file.asLink())
properties:
  formula.属于当前主题:
    displayName: 属于当前主题
  file.name:
    displayName: 名称
  formula.deadline:
    displayName: 期限
  note.进度:
    displayName: 进度（0–100）
views:
  - type: table
    name: 本主题内容
    order:
      - file.name
      - 类型
      - 状态
      - 来源
